<Window x:Class="Manager.Views.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Gestor de Citas ITV" Height="700" Width="1450"
        WindowStartupLocation="CenterScreen"
        Background="#121212">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Regular"/>
        </Style>

        <Style x:Key="DarkComboBoxBarra" TargetType="ComboBox">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Background="#2C2C2E" BorderBrush="#3A3A3C" BorderThickness="1"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="4,2"/>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,2,24,2"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="White"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                                <Border Background="#2C2C2E" BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="4"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,2,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="#2C2C2E"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#007AFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#1E1E1E" Foreground="White" Padding="5">
            <MenuItem Header="_Archivo" Background="#1E1E1E" Foreground="White">
                <MenuItem Header="_Importar..." Command="{Binding ImportarGlobalCommand}" Background="#2C2C2E" Foreground="White"/>
                <MenuItem Header="_Exportar..." Command="{Binding ExportarGlobalCommand}" Background="#2C2C2E" Foreground="White"/>
                <MenuItem Header="_Realizar Backup" Command="{Binding RealizarBackupCommand}" Background="#2C2C2E" Foreground="White"/>
            </MenuItem>
            <MenuItem Header="_Configuración" Command="{Binding MostrarDetallesCommand}" Foreground="White"/>
            <MenuItem Header="A_cerca de" Command="{Binding MostrarAcercaDeCommand}" Foreground="White"/>
        </Menu>

       <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Listado General de Citas Activas"
                           Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#3A3A3C" BorderThickness="1" Padding="12,8" Margin="0,0,0,10" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>     <ColumnDefinition Width="10"/>      <ColumnDefinition Width="95"/>      <ColumnDefinition Width="10"/>      <ColumnDefinition Width="155"/>     <ColumnDefinition Width="10"/>      <ColumnDefinition Width="155"/>     <ColumnDefinition Width="10"/>      <ColumnDefinition Width="140"/>     <ColumnDefinition Width="*"/>       <ColumnDefinition Width="Auto"/>    </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#2C2C2E" BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="6" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="TxtFiltroGlobal" Text="{Binding CitasVM.FiltroTexto, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center" FontSize="12"/>
                                    <TextBlock Text="Buscar texto..." Foreground="#55555A" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtFiltroGlobal}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="#2C2C2E" BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="6" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/> 
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="TxtBusquedaId" Text="{Binding CitasVM.BusquedaId, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center" FontSize="12"/>
                                    <TextBlock Text="ID" Foreground="#55555A" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtBusquedaId}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Grid.Column="2" Content="🔍" Width="18" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding CitasVM.BuscarPorIdCommand}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Background="#2C2C2E" BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="6" Padding="6,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Desde:" Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold"/>
                                <DatePicker SelectedDate="{Binding CitasVM.FiltroFechaInicio, UpdateSourceTrigger=PropertyChanged}" 
                                            Width="105" Background="Transparent" BorderThickness="0">
                                    <DatePicker.Resources>
                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="White"/> <Style.Resources>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </Style.Resources>
                                        </Style>
                                    </DatePicker.Resources>
                                </DatePicker>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Background="#2C2C2E" BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="6" Padding="6,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Hasta:" Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold"/>
                                <DatePicker SelectedDate="{Binding CitasVM.FiltroFechaFin, UpdateSourceTrigger=PropertyChanged}" 
                                            Width="100" Background="Transparent" BorderThickness="0">
                                    <DatePicker.Resources>
                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="White"/> <Style.Resources>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </Style.Resources>
                                        </Style>
                                    </DatePicker.Resources>
                                </DatePicker>
                            </StackPanel>
                        </Border>

                        <ComboBox Grid.Column="8" ItemsSource="{Binding CitasVM.OpcionesMotor}" 
                                  SelectedItem="{Binding CitasVM.FiltroMotor, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource DarkComboBoxBarra}"/>
                        
                        <Button Grid.Column="10" Content="❌" ToolTip="Limpiar Filtros" Width="40" Height="28"
                                Style="{StaticResource ModernButton}" Background="#3A3A3C"
                                Command="{Binding CitasVM.LimpiarFiltrosCommand}"/>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding CitasVM.Citas}"
                          SelectedItem="{Binding CitasVM.CitaSeleccionada}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          Background="#1E1E1E" BorderThickness="1" BorderBrush="#3A3A3C"
                          RowBackground="#1E1E1E" AlternatingRowBackground="#252528"
                          Foreground="White" HorizontalGridLinesBrush="#2C2C2E">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2C2C2E"/>
                            <Setter Property="Foreground" Value="#8E8E93"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#007AFF"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                        <DataGridTextColumn Header="Matrícula" Binding="{Binding Matricula}" Width="95" FontWeight="Bold"/>
                        <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="95"/>
                        <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="90"/>
                        <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="90"/>
                        <DataGridTextColumn Header="Motor" Binding="{Binding Motor}" Width="90"/>
                        <DataGridTextColumn Header="Cilindrada" Binding="{Binding Cilindrada, StringFormat={}{0} cc}" Width="85"/>
                        <DataGridTextColumn Header="F. Matriculación" Binding="{Binding FechaMatriculacion, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                        <DataGridTextColumn Header="F. Inspección" Binding="{Binding FechaInspeccion, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="3" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> 
                        <ColumnDefinition Width="*"/>    
                        <ColumnDefinition Width="Auto"/> 
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="◀ Anterior" Width="90" Height="30" Style="{StaticResource ModernButton}" Command="{Binding CitasVM.PaginaAnteriorCommand}"/>
                        <TextBlock Text="Página" Foreground="#8E8E93" VerticalAlignment="Center" Margin="15,0,5,0"/>
                        <TextBlock Text="{Binding CitasVM.PaginaActual}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="de" Foreground="#8E8E93" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBlock Text="{Binding CitasVM.TotalPaginas}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <Button Content="Siguiente ▶" Width="90" Height="30" Style="{StaticResource ModernButton}" Command="{Binding CitasVM.PaginaSiguienteCommand}"/>
                        <Button Content="+ Nueva Cita" Width="110" Height="30" Margin="20,0,0,0"
                                Style="{StaticResource ModernButton}" Background="#007AFF"
                                Command="{Binding CitasVM.CrearCitaCommand}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="♻ Restaurar Eliminadas" Padding="20,0" Height="32" Margin="15,0,0,0"
                            Style="{StaticResource ModernButton}" Background="#30D158"
                            Command="{Binding CitasVM.AbrirRestoreCommand}"/>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="10" BorderBrush="#3A3A3C" BorderThickness="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Detalles de la Cita" Foreground="#007AFF" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="MATRÍCULA" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding CitasVM.CitaSeleccionada.Matricula, TargetNullValue='---'}" Style="{StaticResource DetailValue}" FontSize="22" FontWeight="Bold" Foreground="#007AFF"/>
                            <TextBlock Text="PROPIETARIO (DNI)" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding CitasVM.CitaSeleccionada.Dni, TargetNullValue='---'}" Style="{StaticResource DetailValue}"/>
                            <TextBlock Text="VEHÍCULO" Style="{StaticResource DetailLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CitasVM.CitaSeleccionada.Marca, TargetNullValue='---'}" Style="{StaticResource DetailValue}"/>
                                <TextBlock Text=" "/>
                                <TextBlock Text="{Binding CitasVM.CitaSeleccionada.Modelo, TargetNullValue=''}" Style="{StaticResource DetailValue}"/>
                            </StackPanel>
                            <TextBlock Text="MOTOR Y CILINDRADA" Style="{StaticResource DetailLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CitasVM.CitaSeleccionada.Motor, TargetNullValue='---'}" Style="{StaticResource DetailValue}"/>
                                <TextBlock Text=" · " Foreground="#8E8E93"/>
                                <TextBlock Text="{Binding CitasVM.CitaSeleccionada.Cilindrada, StringFormat={}{0} cc, TargetNullValue='---'}" Style="{StaticResource DetailValue}"/>
                            </StackPanel>
                            <TextBlock Text="FECHA MATRICULACIÓN" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding CitasVM.CitaSeleccionada.FechaMatriculacion, StringFormat={}{0:dd/MM/yyyy}, TargetNullValue='---'}" Style="{StaticResource DetailValue}"/>
                            <TextBlock Text="FECHA INSPECCIÓN" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding CitasVM.CitaSeleccionada.FechaInspeccion, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue='---'}" Style="{StaticResource DetailValue}" FontWeight="Bold"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <Button Content="Actualizar Cita" Height="35" Margin="0,0,0,8" Style="{StaticResource ModernButton}" Background="#007AFF" Command="{Binding CitasVM.ActualizarCitaCommand}"/>
                        <Button Content="Exportar Info Cita" Height="35" Margin="0,0,0,8" Style="{StaticResource ModernButton}"
                                Command="{Binding InformeVM.ExportarCitaCommand}"
                                CommandParameter="{Binding CitasVM.CitaSeleccionada}"/>
                       <Button Content="Borrar Registro" Height="35" Margin="0,0,0,0" Style="{StaticResource ModernButton}" Background="#FF453A" Command="{Binding CitasVM.BorrarCitaCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>