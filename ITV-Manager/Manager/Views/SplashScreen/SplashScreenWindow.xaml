<Window x:Class="Manager.Views.Splash.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cargando Sistema" Height="260" Width="450"
        WindowStyle="None" 
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Border CornerRadius="12" Background="#1E1E1E" BorderBrush="#3A3A3C" BorderThickness="1.5">
        <Grid Margin="30,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="GESTIÓN ITV LUIS VIVES" 
                           FontSize="26" 
                           FontWeight="Bold" 
                           FontStretch="Expanded" Foreground="#FFFFFF"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Iniciando módulos del sistema..." 
                           FontSize="12" 
                           Foreground="#8E8E93" 
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <ProgressBar x:Name="MiProgressBar" 
                         Grid.Row="1"
                         Height="20" 
                         VerticalAlignment="Center"
                         Minimum="0" 
                         Maximum="100" 
                         Value="0" 
                         Foreground="#007AFF"
                         Background="#3A3A3C"
                         BorderThickness="0"/>
            
            <Button x:Name="BtnCancelar" 
                    Grid.Row="2"
                    Content="Cancelar" 
                    Click="BtnCancelar_Click"
                    Width="100" 
                    Height="32"
                    HorizontalAlignment="Center"
                    Background="#2C2C2E" 
                    Foreground="#FF453A"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontWeight="SemiBold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>